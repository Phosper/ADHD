# Use a long random token before binding the API beyond localhost.
ZHIYU_API_TOKEN=
ZHIYU_MODE=mock
ZHIYU_DB=runtime/zhiyu.sqlite
# Campus inference adapters will use internal addresses, never public credentials.
ZHIYU_LLM_URL=http://127.0.0.1:18081/v1
ZHIYU_LLM_MODEL=Qwen3-8B
ZHIYU_VOICE_ENABLED=0
# Enable only for authorized test recording; files remain in runtime/audio.
ZHIYU_RECORD_AUDIO=0
ZHIYU_ASR_URL=http://127.0.0.1:18082
ZHIYU_TTS_URL=http://127.0.0.1:18083
