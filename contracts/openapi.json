  "components": {
    "schemas": {
      "Case": {
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$",
            "title": "Case Id"
          },
          "version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Version",
            "default": 1
          },
          "company": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Company"
          },
          "brand": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Brand"
          },
          "scene_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$",
            "title": "Scene Id"
          },
          "reason": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Reason"
          },
          "required_actions": {
            "items": {
              "type": "string",
              "maxLength": 4000,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Required Actions"
          },
          "knowledge_refs": {
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,100}$"
            },
            "type": "array",
            "title": "Knowledge Refs"
          },
          "default_channel": {
            "type": "string",
            "enum": [
              "phone",
              "written"
            ],
            "title": "Default Channel",
            "default": "phone"
          },
          "submission_count": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Submission Count",
            "default": 1
          },
          "callback_requested": {
            "type": "boolean",
            "title": "Callback Requested",
            "default": false
          },
          "complaint_risk": {
            "type": "boolean",
            "title": "Complaint Risk",
            "default": false
          },
          "reviewed": {
            "type": "boolean",
            "title": "Reviewed",
            "default": false
          },
          "synthetic": {
            "type": "boolean",
            "title": "Synthetic",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "case_id",
          "company",
          "brand",
          "scene_id",
          "reason",
          "required_actions"
        ],
        "title": "Case"
      },
      "ClientEvent": {
        "properties": {
          "event_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$",
            "title": "Event Id"
          },
          "event_type": {
            "type": "string",
            "enum": [
              "playback.started",
              "playback.stopped",
              "playback.completed",
              "speech.started"
            ],
            "title": "Event Type"
          },
          "generation_id": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Generation Id"
          },
          "client_time_ms": {
            "type": "number",
            "minimum": 0.0,
            "title": "Client Time Ms"
          },
          "played_chars": {
            "type": "integer",
            "maximum": 4000.0,
            "minimum": 0.0,
            "title": "Played Chars",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_id",
          "event_type",
          "generation_id",
          "client_time_ms"
        ],
        "title": "ClientEvent"
      },
      "CreateSession": {
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$",
            "title": "Case Id"
          },
          "request_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$",
            "title": "Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "case_id",
          "request_id"
        ],
        "title": "CreateSession"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NoAnswer": {
        "properties": {
          "request_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$",
            "title": "Request Id"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Version"
          },
          "retry_attempt": {
            "type": "boolean",
            "title": "Retry Attempt",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "expected_version"
        ],
        "title": "NoAnswer"
      },
      "Outcome": {
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$",
            "title": "Case Id"
          },
          "session_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$",
            "title": "Session Id"
          },
          "identity_status": {
            "type": "string",
            "enum": [
              "unknown",
              "confirmed",
              "denied"
            ],
            "title": "Identity Status"
          },
          "contact_status": {
            "type": "string",
            "enum": [
              "connected",
              "no_answer",
              "wrong_person",
              "declined",
              "aborted"
            ],
            "title": "Contact Status"
          },
          "scene_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$",
            "title": "Scene Id"
          },
          "required_actions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Required Actions"
          },
          "merchant_response": {
            "type": "string",
            "enum": [
              "will_resubmit",
              "declined",
              "needs_human",
              "unknown"
            ],
            "title": "Merchant Response"
          },
          "needs_human": {
            "type": "boolean",
            "title": "Needs Human"
          },
          "knowledge_refs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Knowledge Refs"
          },
          "writeback_status": {
            "type": "string",
            "const": "committed",
            "title": "Writeback Status",
            "default": "committed"
          },
          "operation_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$",
            "title": "Operation Id"
          },
          "recommended_channel": {
            "type": "string",
            "enum": [
              "phone",
              "written",
              "human"
            ],
            "title": "Recommended Channel",
            "default": "phone"
          },
          "followup_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,100}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Followup Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "case_id",
          "session_id",
          "identity_status",
          "contact_status",
          "scene_id",
          "required_actions",
          "merchant_response",
          "needs_human",
          "knowledge_refs",
          "operation_id"
        ],
        "title": "Outcome"
      },
